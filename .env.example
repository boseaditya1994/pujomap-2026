# Copy to .env.local and fill in. Never commit real values.
# With everything blank the app runs in local mode: sample data, schematic map,
# no route estimates. That is enough to develop and to run every test.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (docs/supabase-setup.md) --------------------------------------
# Both are safe to expose to the browser; row-level security does the protecting.
# The service-role key is NOT used by this app. Do not add it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Maps (docs/google-cloud-setup.md) -------------------------------
# Browser key: restrict by HTTP referrer and to "Maps JavaScript API" only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional map ID for custom styling. Blank uses Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server key: restrict to "Routes API" only. Never prefix with NEXT_PUBLIC_.
GOOGLE_ROUTES_API_KEY=

# --- Images -----------------------------------------------------------------
# Extra hostnames (comma-separated) whose photos may go through the image
# optimiser. The Supabase host is allowed automatically.
NEXT_PUBLIC_IMAGE_HOSTS=

# --- Local development admin ------------------------------------------------
# Only honoured when Supabase is NOT configured. Use a random value of 16+
# characters, e.g. the output of: openssl rand -hex 24
PUJOMAP_DEV_ADMIN_TOKEN=
